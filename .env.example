# ===== LLM API Keys (fill locally; never commit .env) =====
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=

# ===== Runtime overrides =====
LLM_PROVIDER=deepseek
CONFIG_PATH=config/config.yaml
LOG_LEVEL=INFO
NOTIFY_WEBHOOK_URL=
# Overrides autonomous.enabled when set. Keep false until API keys and risk
# limits have been reviewed.
AUTONOMOUS_TRADING_ENABLED=false

# Python chat starts the scheduler by default. Set false only when a separate
# `python -m src.main run` process is already running.
CHAT_START_SCHEDULER=true
CHAT_OPEN_BROWSER=true
# Optional external macro source; normally the bundled collector writes runtime/macro.
MACRO_SOURCE_DIR=
