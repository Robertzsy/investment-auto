# ===== LLM API Keys (fill locally; never commit .env) =====
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=
FINNHUB_API_KEY=

# ===== Screening database (optional; JSON fallback stays enabled) =====
MONGODB_URI=

# ===== Runtime overrides =====
LLM_PROVIDER=deepseek
CONFIG_PATH=config/config.yaml
LOG_LEVEL=INFO
NOTIFY_WEBHOOK_URL=
# Overrides autonomous.enabled when set. Keep false until API keys and risk
# limits have been reviewed.
AUTONOMOUS_TRADING_ENABLED=false

# Chat is management-only: it never starts the scheduler.  The investment
# Agent (python -m src.main run) is the only execution process.  This legacy
# flag is accepted but ignored.
CHAT_START_SCHEDULER=true
CHAT_OPEN_BROWSER=true
# Optional external macro source; normally the bundled collector writes runtime/macro.
MACRO_SOURCE_DIR=

# ===== Offline research plane (python -m src.main research) =====
# RESEARCH_MAX_ROUNDS=6
# The research loop shell is restricted to the project directory; the trading
# and management planes never get a shell regardless of these settings.
