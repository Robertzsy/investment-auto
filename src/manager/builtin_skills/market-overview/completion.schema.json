{
  "required_steps": ["benchmarks", "breadth", "quality", "report"],
  "required_outputs": ["benchmarks.snapshots", "breadth.sample_size", "quality.coverage_ratio", "report.user_report", "report.data_timestamp", "report.sources"],
  "quality_gates": [
    {"path": "quality.identity_consistent", "operator": "equals", "value": true, "message": "核心指数代码与交易所必须一致"},
    {"path": "quality.freshness_passed", "operator": "equals", "value": true, "message": "核心指数必须带有未过期的交易日期"},
    {"path": "quality.required_indexes_covered", "operator": "equals", "value": true, "message": "必须覆盖上证、深证和创业板核心指数"},
    {"path": "quality.market_breadth_available", "operator": "equals", "value": true, "message": "必须提供可核验的市场涨跌宽度"},
    {"path": "quality.coverage_ratio", "operator": "min", "value": 0.8, "message": "核心市场证据覆盖率必须达到 80%"}
  ]
}
